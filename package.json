{
  "name": "nybar-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.github.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config vite.github.config.ts",
    "build:github-pages": "npm run build",
    "check:questions": "node --experimental-strip-types scripts/audit-question-bank.mjs",
    "check:study": "node scripts/check-study.mjs",
    "check:library": "node scripts/check-library.cjs",
    "check:workspace": "node scripts/check-workspace.cjs",
    "check:question-copy": "node scripts/check-question-copy.cjs",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
